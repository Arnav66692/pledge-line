# Copy this file to .env and fill in the values. Git ignores .env, so keys never get pushed.
# Never paste a key into chat.

# PostgreSQL journal, guarded AI spending and durable PayPal sandbox checkout use separate schemas.
# Does not replace the local donor-call JSONL ledger or enable live payments.
# Use the restricted runtime connection, never the migration owner. Hosted TLS is verified.
# The local integration connection is in ignored .database.env; npm start does not load it automatically.
# Guarded startup loads .env, .database.env and .ai.env explicitly; see SETUP.md.
# DATABASE_URL=
# Hosted acceptance tests are opt-in and write synthetic records to a disposable development database.
# DATABASE_TEST_URL=

# Port for the local server. Render sets its own.
PORT=3000

# Where the line is reachable. Locally http://localhost:3000, on Render the service URL.
# Used for the subscription return link. If empty, Render's RENDER_EXTERNAL_URL is used.
PUBLIC_BASE_URL=http://localhost:3000

# sandbox talks to the PayPal sandbox. mock uses the fake PayPal and never counts.
PAYPAL_MODE=sandbox

# From the pledge-line app in the PayPal Developer Dashboard, with the toggle on Sandbox.
# The integration's ignored .sandbox.env isolates these API credentials from donor subscription settings.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# The id that npm run seed -- --webhook https://YOUR-RENDER-URL/webhooks/paypal prints.
PAYPAL_WEBHOOK_ID=

# Integration: anthropic selects guarded Sonnet 5.5 with Jev advisory routing/review.
# Requires DATABASE_URL, both API keys, explicit migrations and prepaid confirmation below.
# rules is the offline mock option. gemini is an explicit historical pilot option, never a fallback.
# Legacy haiku mode is refused by integration startup.
ROUTER_MODE=anthropic

# Your free Gemini API key from https://aistudio.google.com/apikey. No card or billing needed.
GEMINI_API_KEY=

# Only if Claude tells you to. Leave empty for the default, gemini-3.5-flash-lite.
GEMINI_MODEL=

# Keep the integration keys in ignored .ai.env (mode 600), never command arguments or chat.
# API keys only: no subscription/OAuth token or SDK credential-chain fallback.
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=

# Operator attestation only, not an automatic account/balance check. Leave false until the correct
# provider organization, prepaid-only funding and disabled auto-reload have been verified.
# An API key cannot select the credit pool; some provider orgs use subscription credits first.
AI_PREPAID_ONLY_CONFIRMED=false
# Development allocation caps, not provider balances. A shared durable stop blocks both providers.
AI_BUDGET_SCOPE=pledge-line
AI_ANTHROPIC_LIMIT_USD=5
AI_JEV_LIMIT_USD=0.25

# Default procurement is fully simulated. mcp-sandbox requires DATABASE_URL, checkout schema,
# operator registry, dedicated MCP_*TOKEN credentials and exact PayPal sandbox merchant IDs.
PROCUREMENT_SUPPLIER_MODE=mock
SUPPLIER_REGISTRY_PATH=.suppliers.json
# Keep dedicated supplier tokens in ignored .suppliers.env, never reuse API/database credentials.
# MCP_SUPPLIER_TOKEN=
# Enables order creation/capture only after 2026-11-05T05:00:00Z (Nov 4, 9 pm PT).
# Buyer approval and exact quote/payment checks are still required. No live money.
PAYPAL_SANDBOX_CHECKOUT_WRITES=false

# Four to six digits. Not 1111, 2222 or 3333, since Script 8 uses those as wrong PINs.
PILOT_PIN=

# The nonprofit's name the line speaks. Fictional for the pilot. At most 114 characters, with no digits
# and no word the line only takes from PayPal, such as a status word like active or paid.
ORG_NAME=Sunny Hollow Pantry

# The seeded sandbox subscription. If empty, it is read from .pilot/state.json.
DEMO_SUBSCRIPTION_ID=

# The event log. Leave this unset. Sandbox calls go to .pilot/ledger.jsonl, which the pilot is graded from,
# and mock or rules calls go to .pilot/mock-ledger.jsonl, so practice calls never mix with graded ones.
# LEDGER_PATH=

# Time zone for spoken dates.
TIME_ZONE=America/Los_Angeles

# Optional. Turns on the staff view at /staff, where a coordinator reads last night's calls and their receipts.
# At least 16 characters, letters, digits and marks with no spaces. Leave empty and every staff page is a 404.
STAFF_KEY=

# Covered Month's sponsor hold, the PayPal authorization id. If empty, it is read from .pilot/state.json after
# npm run seed:hold. With no hold, the line says the hardship fund isn't open and moves nothing.
SPONSOR_HOLD_ID=

# Covered Month's staff rule. Unset, it is up to $50, within 30 days of the charge, once a year. COVER_PER_YEAR=0 turns it off.
# COVER_MAX_DOLLARS=50
# COVER_WINDOW_DAYS=30
# COVER_PER_YEAR=1
# Optional. Turns on the donor's receipt, the button after a call, /receipt, /check and /receipt-key.
# 64 hex characters, a random 32-byte Ed25519 key that signs every receipt. Make one with
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret, and keep the same key, since a new key can't check receipts the old one signed.
# Leave empty and every receipt page and route is a 404.
RECEIPT_SIGNING_KEY=

# Optional, for the mock only. Stages one fault on the mock PayPal, so you can see the recovery timeline. Every call is
# labeled a fault drill. One of suspend-timeout, suspend-503, suspend-refused or gift-changed. Leave it out otherwise.
# FAULT_DRILL=
