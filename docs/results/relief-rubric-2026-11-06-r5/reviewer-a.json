  "threeMaterialDeductions": [
    {
      "area": "AI breadth and reliability",
      "affectedCriteria": [
        "Technological Implementation",
        "Innovation/Idea"
      ],
      "evidence": "Earlier donor-label zero-wrong-mutation gate and purchase-drafting gate remain failed. New 12/12 task result uses composed guards, 12 purposive synthetic tasks, scripted rejection of unexpected offers and mock payments; models add seconds.",
      "improvement": "Keep the current separate claims and address remaining wrong labels, weak purchase drafting and generic clarification behavior before making broader AI claims."
    },
    {
      "area": "Impact confidence and coverage economics",
      "affectedCriteria": [
        "Potential Impact"
      ],
      "evidence": "No demonstrated sponsor demand/partnership, donor or staff benefit, retention uplift or willingness to pay; equal gross funding incurs fees.",
      "improvement": "Make sponsor funding/fee assumptions concrete and gather appropriately bounded target-audience feedback when available; these are paths to greater impact confidence, not mandatory hackathon features."
    },
    {
      "area": "Primary demonstration readability",
      "affectedCriteria": [
        "Design",
        "Presentation"
      ],
      "evidence": "Native 390px and 1440px entry screenshots retain small desktop UI text in the film. The new native cards resolve readability for recorded AI outcomes but do not change the movie.",
      "improvement": "Make the existing full-size playback affordance or focused visual attention clearer while retaining the honest film/explorer scope labels."
    }
